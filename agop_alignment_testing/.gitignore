.venv/
__pycache__/
*.pyc
.vscode/
# Run artifacts are local and reproducible: configs/ + the seed in each config fully
# determine them, so they are regenerated rather than versioned (~500MB per corpus
# build, and a fresh copy would enter history on every rebuild). Covers runs/<run_id>/
# too, which is runner.run's default output path -- not just runs/phase2/.
runs/*
!runs/.gitkeep
# Figures are small and worth versioning, unlike the feature matrices. runs/plots/ is
# the one path under runs/ that stays tracked; plotting scripts write there.
!runs/plots/
# GPL-3.0 reference clone -- see external/README.md for how to get it.
external/rfm-grokking/
